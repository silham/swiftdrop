{
  "name": "@swiftdrop/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS modular monolith — the SwiftDrop business API.",
  "scripts": {
    "dev": "nest start --watch --preserveWatchOutput",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:int": "jest -c test/jest-int.config.js --runInBand",
    "test:int:cov": "jest -c test/jest-int.config.js --runInBand --coverage",
    "test:cov:all": "jest -c jest.all.config.js --runInBand --coverage",
    "openapi:export": "swc src -d .openapi/src --strip-leading-paths -q && swc scripts -d .openapi/scripts --strip-leading-paths -q && node .openapi/scripts/export-openapi.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@swiftdrop/contracts": "workspace:*",
    "@swiftdrop/db": "workspace:*",
    "amqp-connection-manager": "4.1.15",
    "amqplib": "2.2.0",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "google-auth-library": "11.3.1",
    "helmet": "8.3.0",
    "minio": "8.0.7",
    "nestjs-pino": "5.3.1",
    "pdfkit": "0.20.2",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.7",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.18",
    "@swc/jest": "0.2.39",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/multer": "2.3.0",
    "@types/pdfkit": "0.17.6",
    "@types/supertest": "7.2.1",
    "chokidar": "5.0.0",
    "jest": "30.5.2",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
