# ─────────────────────────────────────────────────────────────────────────────
# SwiftDrop environment. Copy to .env (`make setup` does it). NEVER commit .env.
# Values below are DEV-ONLY defaults that work with compose.yaml.
# Adding a variable? Add it here + to the zod schema (apps/api/src/config/env.ts
# or apps/worker/src/config/env.ts) in the same PR.
# ─────────────────────────────────────────────────────────────────────────────

# ── shared ───────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
APP_URL=http://localhost:8080
DATABASE_URL=postgresql://swiftdrop:swiftdrop@postgres:5432/swiftdrop
TEST_DATABASE_URL=postgresql://swiftdrop:swiftdrop@postgres:5432/swiftdrop_test
SHADOW_DATABASE_URL=postgresql://swiftdrop:swiftdrop@postgres:5432/swiftdrop_shadow
RABBITMQ_URL=amqp://swiftdrop:swiftdrop@rabbitmq:5672
# base64 32 bytes — generate a new one with: openssl rand -base64 32
WEBHOOK_SECRET_ENC_KEY=c3dpZnRkcm9wLWRldi1vbmx5LXdlYmhvb2sta2V5ISE=

# ── api (M1/M2) ──────────────────────────────────────────────────────────────
PORT=4000
CORS_ORIGINS=http://localhost:8080,http://localhost:3000
# generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-0123456789abcdef
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7
JWT_ISSUER=swiftdrop-api
JWT_AUDIENCE=swiftdrop-web
COOKIE_SECURE=false
ENABLE_DEV_LOGIN=true
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300
# Reverse proxies in front of the API (the Caddy gateway = 1; Coolify/Traefik + Caddy = 2)
TRUST_PROXY_HOPS=1

# --- AI assistant on the tracking page (M1). Any OpenAI-compatible API; empty key = switched off ---
# OpenAI:   LLM_BASE_URL=https://api.openai.com/v1                                  LLM_MODEL=gpt-4o-mini
# DeepSeek: LLM_BASE_URL=https://api.deepseek.com                                    LLM_MODEL=deepseek-chat
# Gemini:   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai     LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=20000

# Google OAuth (M2) — create credentials at console.cloud.google.com; leave blank to disable
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/api/v1/auth/google/callback

# Object storage (M6) — MinIO console: http://localhost:9001
S3_ENDPOINT=minio
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=swiftdrop
S3_SECRET_KEY=swiftdrop-secret
S3_BUCKET_POD=proof-of-delivery
UPLOAD_MAX_BYTES=5242880

# ── worker (M8) ──────────────────────────────────────────────────────────────
WORKER_HEALTH_PORT=4100
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM="SwiftDrop <no-reply@swiftdrop.test>"
SMS_PROVIDER=log
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_RETRY_DELAYS_MS=10000,60000,300000

# ── web (Next.js) ────────────────────────────────────────────────────────────
# Server-side calls from Next.js go straight to the api container:
API_INTERNAL_URL=http://api:4000
# Browser calls use the same origin via the gateway:
NEXT_PUBLIC_API_BASE=/api/v1
NEXT_PUBLIC_ENABLE_DEV_LOGIN=true
